{
  "name": "helsinki-moves",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "vite build",
    "check:syntax": "tsc --noEmit --pretty false",
    "ci": "npm run ci:syntax && npm run ci:unit && npm run ci:coverage && npm run ci:e2e",
    "ci:coverage": "npm run test:coverage",
    "ci:e2e": "npm run test:e2e:chromium",
    "ci:syntax": "npm run typecheck",
    "ci:unit": "npm run test:unit",
    "dev": "vite",
    "env:check": "node tools/check-runtime-env.mjs",
    "lint": "npm run check:syntax",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "perf:bundle": "npm run build && node tools/check-bundle-budgets.mjs",
    "release:validate": "npm run env:check && npm run check:syntax && npm run test:unit && npm run ui:perf && npm run ui:flicker && npm run perf:bundle && npm run ui:check && npx playwright test tests/e2e/voice-search.spec.ts --project=chromium && npx playwright test tests/e2e/voice-search.spec.ts --project=mobile-chromium",
    "smoke:live": "playwright test -c playwright.smoke.config.ts",
    "test": "npm run lint && npm run test:coverage",
    "test:coverage": "vitest run --coverage --reporter=verbose 2>&1 | node tools/filter-vitest-output.mjs",
    "test:quick": "npm run test:unit && npm run lint",
    "test:unit": "vitest run --reporter=verbose 2>&1 | node tools/filter-vitest-output.mjs",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:install": "playwright install --with-deps chromium firefox webkit",
    "ui:baseline": "playwright test tests/e2e/ui-visual-regression.spec.ts --project=chromium --update-snapshots",
    "ui:check": "playwright test tests/e2e/ui-visual-regression.spec.ts --project=chromium",
    "ui:fast": "npm run ui:geometry && playwright test tests/e2e/departures-interactions.spec.ts --project=chromium",
    "ui:flicker": "playwright test tests/e2e/light-theme-controls-stability.spec.ts --project=chromium",
    "ui:geometry": "playwright test tests/e2e/ui-geometry-contracts.spec.ts --project=chromium",
    "ui:perf": "playwright test tests/e2e/mode-switch-responsiveness.spec.ts --project=chromium",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.63",
    "@ai-sdk/google": "^3.0.52",
    "@ai-sdk/react": "^3.0.136",
    "@json-render/core": "^0.14.1",
    "@json-render/react": "^0.14.1",
    "@json-render/shadcn": "^0.14.1",
    "ai": "^6.0.134",
    "hono": "^4.9.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.0.0"
  }
}
